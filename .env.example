# 파이널 유도 멀티짐 local development defaults.
# 실제 비밀값은 이 파일에 넣지 말고 .env.local에만 둡니다.

# Runtime storage. 기본 개발 모드는 JSON 파일 저장소입니다.
FINAL_JUDO_DB_DRIVER=json
FINAL_JUDO_DATA_DIR=.data
PILOT_DB_FILE=.data/final-judo-db.json

# PostgreSQL runtime store를 로컬에서 리허설할 때만 사용합니다.
# FINAL_JUDO_DB_DRIVER=postgres
FINAL_JUDO_POSTGRES_URL=
FINAL_JUDO_POSTGRES_STATE_KEY=mvp
FINAL_JUDO_POSTGRES_TABLE=app_runtime_state

# 개발/테스트 편의 플래그. production에서는 기본 비활성 상태를 유지합니다.
FINAL_JUDO_ENABLE_DEMO_LOGIN=0
FINAL_JUDO_ENABLE_DEV_RESET=0

# 온라인 결제/정기결제 provider-neutral 리허설.
# 비어 있으면 mock provider와 앱 내부 checkout URL을 사용합니다.
FINAL_JUDO_PAYMENT_PROVIDER=
FINAL_JUDO_PAYMENT_CHECKOUT_BASE_URL=
FINAL_JUDO_PAYMENT_WEBHOOK_SECRET=

# PWA push 리허설. 실제 발송은 운영 VAPID 키 설정 후 활성화합니다.
FINAL_JUDO_VAPID_PUBLIC_KEY=
FINAL_JUDO_VAPID_PRIVATE_KEY=
FINAL_JUDO_VAPID_SUBJECT=mailto:ops@finaljudo.test
CRON_SECRET=

# Smoke/E2E local target.
SMOKE_BASE_URL=http://localhost:3000
