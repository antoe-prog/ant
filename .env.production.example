# 파이널 유도 멀티짐 production/pilot environment checklist.
# placeholder를 실제 운영 secret으로 교체한 뒤 배포 플랫폼 secret store에 넣습니다.

NODE_ENV=production

# 운영은 PostgreSQL runtime store를 기본으로 사용합니다.
FINAL_JUDO_DB_DRIVER=postgres
FINAL_JUDO_DATA_DIR=
PILOT_DB_FILE=
FINAL_JUDO_POSTGRES_URL=postgresql://USER:PASSWORD@HOST:5432/final_judo
FINAL_JUDO_INSTALLATION_ID=replace-with-stable-installation-id
FINAL_JUDO_POSTGRES_STATE_KEY=mvp
FINAL_JUDO_POSTGRES_TABLE=app_runtime_state

# 위험 플래그. production 상시 운영에서는 반드시 0 또는 미설정입니다.
FINAL_JUDO_ENABLE_DEMO_LOGIN=0
FINAL_JUDO_ENABLE_DEV_RESET=0
FINAL_JUDO_ENABLE_DEV_SMS_CODE=0

# 비밀번호 재설정 SMS provider adapter.
FINAL_JUDO_PASSWORD_RESET_SMS_WEBHOOK_URL=https://sms-provider.example.com/password-reset
FINAL_JUDO_PASSWORD_RESET_SMS_WEBHOOK_TOKEN=replace-with-provider-bearer-token

# 온라인 결제/정기결제 provider 설정.
FINAL_JUDO_PAYMENT_PROVIDER=external
FINAL_JUDO_PAYMENT_CHECKOUT_BASE_URL=https://payments.example.com
FINAL_JUDO_PAYMENT_WEBHOOK_SECRET=replace-with-provider-webhook-secret

# Native app push. private key는 운영 secret store에만 저장합니다.
FINAL_JUDO_PUSH_ENABLED=1
FINAL_JUDO_APNS_TEAM_ID=replace-with-apple-team-id
FINAL_JUDO_APNS_KEY_ID=replace-with-apns-key-id
FINAL_JUDO_APNS_TOPIC=kr.co.finaljudo.multigym
FINAL_JUDO_APNS_PRIVATE_KEY=replace-with-apns-p8-private-key
FINAL_JUDO_APNS_ENVIRONMENT=production
FINAL_JUDO_APNS_TTL_SECONDS=86400
FINAL_JUDO_FIREBASE_PROJECT_ID=replace-with-firebase-project-id
FINAL_JUDO_FIREBASE_CLIENT_EMAIL=replace-with-firebase-client-email
FINAL_JUDO_FIREBASE_PRIVATE_KEY=replace-with-firebase-private-key

# Web Push를 별도로 제공할 때만 설정합니다.
FINAL_JUDO_VAPID_PUBLIC_KEY=
FINAL_JUDO_VAPID_PRIVATE_KEY=
FINAL_JUDO_VAPID_SUBJECT=

# Vercel Cron이 푸시 outbox 재시도 API를 호출할 때 사용하는 Bearer secret.
CRON_SECRET=replace-with-random-cron-secret
