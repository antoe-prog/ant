{
  "schemaVersion": 1,
  "strategy": "trusted-web-activity",
  "packageName": "kr.co.finaljudo.multigym",
  "appName": "파이널 유도 멀티짐 운영",
  "launcherName": "파이널 유도",
  "web": {
    "productionOrigin": "https://TODO_PRODUCTION_HOST",
    "manifestPath": "/manifest.webmanifest",
    "startUrl": "/app",
    "scope": "/"
  },
  "build": {
    "tool": "bubblewrap",
    "outputs": ["apk", "aab"],
    "androidProjectDir": "mobile/android/twa",
    "fallbackType": "webview",
    "minSdk": 23,
    "targetSdk": 35
  },
  "signing": {
    "releaseKeySha256": "TODO_RELEASE_CERT_SHA256_FINGERPRINT",
    "keystorePath": "DO_NOT_COMMIT_RELEASE_KEYSTORE"
  },
  "verification": {
    "assetLinksTemplate": "mobile/android/assetlinks.template.json",
    "requiresHttps": true,
    "requiresDigitalAssetLinks": true,
    "requiresJdkAndAndroidSdk": true
  }
}
