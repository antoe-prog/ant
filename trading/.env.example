# 토스증권 WTS > 설정 > Open API 에서 발급
TOSSQUANT_CLIENT_ID=
TOSSQUANT_CLIENT_SECRET=

# 주문에 사용할 계좌 (X-Tossinvest-Account 헤더). 계좌 조회로 확인 가능.
TOSSQUANT_ACCOUNT_ID=

# paper = 가상 체결(실주문 없음) / live = 실주문
TOSSQUANT_MODE=paper

# 대상 종목 (쉼표 구분)
TOSSQUANT_SYMBOLS=AAPL,MSFT,NVDA

# 페이퍼 트레이딩 시작 자본 (USD)
TOSSQUANT_PAPER_CASH=10000

# 체결 비용 모델 (bps). 슬리피지=시장충격, 스프레드=호가 폭 — 별개 비용이라 둘 다 붙는다.
TOSSQUANT_PAPER_SLIPPAGE_BPS=5
TOSSQUANT_PAPER_COMMISSION_BPS=7
TOSSQUANT_BACKTEST_SPREAD_BPS=2

# 전략 파라미터 (SMA 크로스)
TOSSQUANT_SMA_FAST=20
TOSSQUANT_SMA_SLOW=60

# 리스크 한도
TOSSQUANT_MAX_POSITION_PCT=0.25
TOSSQUANT_MAX_POSITIONS=4
TOSSQUANT_MAX_DAILY_LOSS_PCT=0.03

# 보호 청산 (0 = 끄기). 전략과 무관하게 동작한다.
# 손절은 켜 두는 걸 권한다 — 추세추종 전략의 청산 신호는 급락에 수십 봉 늦다.
TOSSQUANT_STOP_LOSS_PCT=0.08
TOSSQUANT_TRAILING_STOP_PCT=0
TOSSQUANT_TAKE_PROFIT_PCT=0
TOSSQUANT_MAX_HOLDING_DAYS=0
# 보호 청산 후 같은 종목 재진입을 막는 기간 (휩쏘 방지)
TOSSQUANT_STOP_COOLDOWN_DAYS=3

# 루프 주기(초)
TOSSQUANT_POLL_SECONDS=60

# --- 알림 (비우면 비활성) ---
# 텔레그램: @BotFather로 봇 생성 → 토큰 발급 → 봇에게 메시지 한 번 보낸 뒤
#   curl https://api.telegram.org/bot<TOKEN>/getUpdates 로 chat_id 확인
TOSSQUANT_TELEGRAM_BOT_TOKEN=
TOSSQUANT_TELEGRAM_CHAT_ID=
TOSSQUANT_SLACK_WEBHOOK_URL=
# 같은 사유의 알림 재전송 최소 간격(초). 오류 폭탄 방지.
TOSSQUANT_NOTIFY_THROTTLE_SECONDS=300
TOSSQUANT_NOTIFY_FILLS=true
TOSSQUANT_NOTIFY_DAILY_SUMMARY=true
